# ==============================================================================
# DexDenso Teleoperation Framework - Environment Configuration Template
# ==============================================================================

# DENSO RC8 / RC8A Controller (Physical or WINCAPS III Virtual Simulator)
ROBOT_HOST=192.168.1.131
ROBOT_PORT=49152
AUTO_RECONNECT=true
RECONNECT_INTERVAL_SEC=3.0

# NVIDIA Isaac Sim UDP Digital Twin Bridge
ISAAC_SIM_HOST=127.0.0.1
ISAAC_SIM_PRIMARY_PORT=5008
ISAAC_SIM_FALLBACK_PORT=5005

# Vision & Camera Parameters
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=60

# Teleoperation Dynamics & Rate Control
TELEOP_RATE_HZ=60.0
FILTER_MIN_CUTOFF=1.5
FILTER_BETA=20.0
FILTER_DCUTOFF=1.0
